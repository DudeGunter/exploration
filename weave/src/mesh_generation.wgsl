// ============= MESH GENERATION FROM DENSITY FIELD =============
// Shader 2: Generate mesh from density field

struct NoiseParams {
    chunk_x: i32,
    chunk_y: i32,
    chunk_z: i32,
    scale: f32,
    frequency: f32,
    amplitude: f32,
    octaves: u32,
}

struct MarchVertex {
    position: vec3<f32>,
}

struct MeshOutput {
    vertices: array<MarchVertex, 65535>,
    vertex_count: atomic<u32>,
    indices: array<u32, 65535>,
    index_count: atomic<u32>,
}

@group(0) @binding(0)
var<uniform> mesh_params: NoiseParams;

@group(0) @binding(1)
var<storage, read> density_field_read: array<f32>;

@group(0) @binding(2)
var<storage, read_write> mesh_output: MeshOutput;

const ISOLEVEL: f32 = 0.0;
const MAX_VERTS: u32 = 65535u;

const FIELD_SIZE: u32 = 65u;
const FIELD_STRIDE: u32 = FIELD_SIZE * FIELD_SIZE;

fn get_density(x: u32, y: u32, z: u32) -> f32 {
    let idx = x + y * FIELD_SIZE + z * FIELD_STRIDE;
    return density_field_read[idx];
}

fn edge_endpoints(edge: u32) -> vec2<u32> {
    switch(edge) {
        case 0u:  { return vec2<u32>(0u, 1u); }
        case 1u:  { return vec2<u32>(1u, 2u); }
        case 2u:  { return vec2<u32>(2u, 3u); }
        case 3u:  { return vec2<u32>(3u, 0u); }
        case 4u:  { return vec2<u32>(4u, 5u); }
        case 5u:  { return vec2<u32>(5u, 6u); }
        case 6u:  { return vec2<u32>(6u, 7u); }
        case 7u:  { return vec2<u32>(7u, 4u); }
        case 8u:  { return vec2<u32>(0u, 4u); }
        case 9u:  { return vec2<u32>(1u, 5u); }
        case 10u: { return vec2<u32>(2u, 6u); }
        case 11u: { return vec2<u32>(3u, 7u); }
        default:  { return vec2<u32>(0u, 0u); }
    }
}

fn corner_offset(i: u32) -> vec3<u32> {
    switch(i) {
        case 0u: { return vec3<u32>(0u, 0u, 0u); }
        case 1u: { return vec3<u32>(1u, 0u, 0u); }
        case 2u: { return vec3<u32>(1u, 1u, 0u); }
        case 3u: { return vec3<u32>(0u, 1u, 0u); }
        case 4u: { return vec3<u32>(0u, 0u, 1u); }
        case 5u: { return vec3<u32>(1u, 0u, 1u); }
        case 6u: { return vec3<u32>(1u, 1u, 1u); }
        case 7u: { return vec3<u32>(0u, 1u, 1u); }
        default: { return vec3<u32>(0u, 0u, 0u); }
    }
}

fn interpolate(p1: vec3<f32>, v1: f32, p2: vec3<f32>, v2: f32) -> vec3<f32> {
    if abs(v2 - v1) < 0.0001 {
        return (p1 + p2) * 0.5;
    }
    let t = (ISOLEVEL - v1) / (v2 - v1);
    return mix(p1, p2, clamp(t, 0.0, 1.0));
}

@compute @workgroup_size(4, 4, 4)
fn mesh_main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    if any(global_id >= vec3<u32>(FIELD_SIZE - 1u)) {
        return;
    }

    let size_f = f32(FIELD_SIZE - 1u);
    let chunk_offset = vec3<f32>(
        f32(mesh_params.chunk_x),
        f32(mesh_params.chunk_y),
        f32(mesh_params.chunk_z)
    ) * size_f;

    let local_pos = vec3<f32>(global_id);

    // Sample 8 corners from density field
    var corners: array<f32, 8>;
    var cube_index = 0u;

    for (var i = 0u; i < 8u; i++) {
        let offset = corner_offset(i);
        corners[i] = get_density(global_id.x + offset.x, global_id.y + offset.y, global_id.z + offset.z);

        if (corners[i] < ISOLEVEL) {
            cube_index |= (1u << i);
        }
    }

    // Skip if cube is entirely inside or outside
    if (cube_index == 0u || cube_index == 255u) {
        return;
    }

    // Generate triangles
    let tri_base = cube_index * 16u;
    var edge_vertices: array<u32, 12>;
    var edge_valid: array<bool, 12>;

    for (var i = 0u; i < 12u; i++) {
        edge_valid[i] = false;
    }

    // Process triangle table
    for (var i = 0u; i < 16u; i += 3u) {
        let e0 = i32(TRI_TABLE[tri_base + i]);
        if (e0 == -1) { break; }

        let e1 = i32(TRI_TABLE[tri_base + i + 1u]);
        let e2 = i32(TRI_TABLE[tri_base + i + 2u]);

        let edges = array<u32, 3>(u32(e0), u32(e1), u32(e2));
        var vert_indices: array<u32, 3>;

        // Get or create vertices for each edge
        for (var j = 0u; j < 3u; j++) {
            let edge_idx = edges[j];

            if (!edge_valid[edge_idx]) {
                // Create new vertex for this edge
                let endpoints = edge_endpoints(edge_idx);
                let offset_p0 = corner_offset(endpoints.x);
                let offset_p1 = corner_offset(endpoints.y);

                let p0 = local_pos + vec3<f32>(offset_p0);
                let p1 = local_pos + vec3<f32>(offset_p1);
                let v0 = corners[endpoints.x];
                let v1 = corners[endpoints.y];

                let vert_pos = interpolate(p0, v0, p1, v1);
                let vert_idx = atomicAdd(&mesh_output.vertex_count, 1u);

                if (vert_idx < MAX_VERTS) {
                    mesh_output.vertices[vert_idx] = MarchVertex(vert_pos);
                    edge_vertices[edge_idx] = vert_idx;
                    edge_valid[edge_idx] = true;
                }
            }

            vert_indices[j] = edge_vertices[edge_idx];
        }

        // Add triangle indices
        let idx_start = atomicAdd(&mesh_output.index_count, 3u);
        if (idx_start + 3u < MAX_VERTS) {
            mesh_output.indices[idx_start] = vert_indices[0];
            mesh_output.indices[idx_start + 1u] = vert_indices[1];
            mesh_output.indices[idx_start + 2u] = vert_indices[2];
        }
    }
}

